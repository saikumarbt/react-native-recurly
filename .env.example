EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
EXPO_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat public SDK key(s) — PUBLIC keys, safe in the client bundle. NEVER
# put the sk_ secret key here. Put real values in .env.local (gitignored).
# If none is set, the app falls back to the dev Pro toggle in Settings.
# Test Store (current — no store accounts yet): a single test_-prefixed key.
# It is honoured only in DEV builds (the SDK halts a release build on a test key).
EXPO_PUBLIC_RC_API_KEY=test_REPLACE_ME
# Real stores (later): platform keys take precedence over the key above.
# EXPO_PUBLIC_RC_API_KEY_IOS=appl_REPLACE_ME
# EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_REPLACE_ME
